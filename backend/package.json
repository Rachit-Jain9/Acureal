{
  "name": "acureal-backend",
  "version": "1.0.0",
  "description": "Real Estate Development Intelligence Platform - Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev --prefix ../frontend\"",
    "test": "jest --no-cache",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "node scripts/run-sql.js ../database/schema.sql",
    "seed": "node scripts/run-sql.js ../database/seed.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@google/generative-ai": "^0.21.0",
    "@sentry/node": "^10.64.0",
    "@supabase/supabase-js": "^2.103.0",
    "@vercel/blob": "^2.3.3",
    "@vercel/functions": "^3.5.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.35.0",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "overridesRationale": {
    "brace-expansion": "<=5.0.7 carries a DoS advisory (GHSA-mh99-v99m-4gvg) that reaches production via exceljs → archiver → glob → minimatch, and dev via the jest toolchain. npm's only offered remedy is exceljs@3.4.0 — a breaking downgrade that would destroy the v2 workbook. 5.0.8 is the patched line and the public API (a single exported expand function) is unchanged, so pinning it fixes every branch without touching exceljs. Remove once the intermediate packages widen their own ranges."
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
