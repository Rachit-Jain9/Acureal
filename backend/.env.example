NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@HOST:PORT/postgres

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cold (uninvited) sign-up. Default-deny: leave unset or "false" to require an
# invitation token for every new account. Set to "true" only while you are
# actively bootstrapping the very first user, then turn back off.
ALLOW_COLD_SIGNUP=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://redip.vercel.app
CRON_SECRET=replace-with-a-long-random-secret-for-vercel-crons

# Upload validation
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg,image/jpg,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# Storage: use Vercel Blob or Supabase storage
BLOB_READ_WRITE_TOKEN=
SUPABASE_URL=
# Preferred for backend storage access. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=redip-documents

# AI providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI routing
AI_PROVIDER_DOCUMENT_CLASSIFICATION=gemini
AI_PROVIDER_DOCUMENT_EXTRACTION=gemini
AI_PROVIDER_TRANSLATION=gemini
AI_PROVIDER_REASONING=claude
AI_PROVIDER_MARKET_SYNTHESIS=claude
GEMINI_MODEL=gemini-1.5-flash
CLAUDE_MODEL=claude-sonnet-4-6

# Optional backend geocoding
GOOGLE_MAPS_API_KEY=

# ─── Inbound email ingestion (Tier-0 data flywheel) ─────────────────────────
# Webhook auth: choose one (HMAC preferred, Basic for Postmark free tier).
# HMAC: provider signs raw body as `X-Webhook-Signature: sha256=<hex>` keyed
#       by this shared secret. Mismatched signatures are 401 (no fallthrough).
INGEST_WEBHOOK_HMAC_KEY=
# Basic: only used when HMAC is not configured. Postmark URL becomes
#       `https://<user>:<pass>@api.redip.app/api/ingest/email/postmark`.
INGEST_WEBHOOK_BASIC_USER=
INGEST_WEBHOOK_BASIC_PASS=
# Org routing: MVP single-tenant. Every inbound email lands in this org.
# Multi-tenant routing via MailboxHash is a TODO once a 2nd org onboards.
DEFAULT_INGEST_ORGANIZATION_ID=
