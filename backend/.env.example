NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@HOST:PORT/postgres

# How the connection verifies the database server.
#   relaxed      (default in production) encrypt, but do NOT authenticate the
#                certificate — the historical behaviour
#   verify-full  validate the certificate chain AND the hostname
#   disable      no TLS at all (local Postgres)
# verify-full needs DATABASE_CA_CERT: Supabase signs the pooler with a private
# CA ("Supabase Intermediate 2021 CA"), which is not in Node's trust store, so
# enabling it without the CA fails EVERY connection. Check first with:
#   node backend/scripts/check-db-tls.js
DATABASE_SSL_MODE=
# PEM contents of the provider CA. Supabase dashboard →
# Settings → Database → SSL Configuration → Download certificate.
DATABASE_CA_CERT=

# Auth
JWT_SECRET=replace-with-a-long-random-secret
# Access-token TTL. Sessions use short-lived access tokens refreshed via an
# httpOnly cookie — keep this short (the cookie design assumes ~15m).
JWT_EXPIRES_IN=15m
# Signs every deal_events audit row. Required — a missing key breaks the
# tamper-evident audit trail. Generate once with: openssl rand -hex 32
DEAL_EVENTS_HMAC_KEY=replace-with-a-long-random-secret

# Sign-up is OPEN to everyone (the ALLOW_COLD_SIGNUP invite gate was removed in
# PR #507 — anyone with a valid email + password, or Google, can register their
# own workspace). This variable is no longer read by the code; kept here only as
# a breadcrumb so nobody re-adds a gate expecting it to work.
#
# New-signup operator notifications: when someone joins, Acureal emails the
# platform operator(s) a short digest. Recipients come from PLATFORM_ADMIN_EMAILS
# (below); delivery reuses RESEND_API_KEY + MAIL_FROM (below). With Resend unset,
# the email is skipped (best-effort) — the in-app Admin › Signups page still
# records every account.
# ALLOW_COLD_SIGNUP=  (removed — do not rely on)

# Platform operator break-glass allowlist (comma-separated). The persisted
# users.is_platform_admin flag (migration 20260803) is the primary operator
# source; this list is the un-lockable-out fallback and also feeds the
# new-signup email digest recipients. The frontend carries NO operator list —
# it renders the server-computed is_platform_admin fact from /auth/me.
PLATFORM_ADMIN_EMAILS=

# Platform org pin (UUID of the workspace whose verified comps / benchmarks /
# curated notes are shared platform-wide).
#
# REQUIRED on any deploy since the M1 tenant-isolation flip (2026-07-28). The
# legacy fallback looks the operator up in `users` BY EMAIL, but the app now
# connects as `redip_app` (NOBYPASSRLS, not the table owner), and RLS on `users`
# only exposes yourself and your org-mates. So for every user who is not the
# operator the lookup returns zero rows, logs `platform_org_admin_not_found`,
# and the shared comps catalog + Market Intelligence benchmarks silently render
# EMPTY — looking like "no data" rather than a fault. Setting this pin skips the
# DB lookup entirely (resolution order #1) and is the supported fix.
# Find it: SELECT default_organization_id FROM users WHERE email = '<operator email>';
PLATFORM_ORG_ID=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://acureal.in
CRON_SECRET=replace-with-a-long-random-secret-for-vercel-crons

# Upload validation
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg,image/jpg,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# Storage: use Vercel Blob or Supabase storage
BLOB_READ_WRITE_TOKEN=
SUPABASE_URL=
# Preferred for backend storage access. Never expose this to the browser.
# SUPABASE_KEY is also accepted as a legacy alias for this value.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=redip-documents

# AI providers
GEMINI_API_KEY=
# ANTHROPIC_API_KEY is used for narrative synthesis and the document-extraction
# fallback path (Gemini → Claude when Gemini fails on a specific document).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI routing (post 2026-05-11: reasoning + market synthesis on OpenAI GPT-5.4)
AI_PROVIDER_DOCUMENT_CLASSIFICATION=gemini
AI_PROVIDER_DOCUMENT_EXTRACTION=gemini
AI_PROVIDER_TRANSLATION=gemini
AI_PROVIDER_REASONING=openai
AI_PROVIDER_MARKET_SYNTHESIS=openai
AI_PROVIDER_NARRATIVE_SYNTHESIS=claude
GEMINI_MODEL=gemini-3.1-flash-lite
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-5.4
# Hard ceiling on AI spend per UTC day; calls past the cap are blocked.
AI_DAILY_COST_CAP_USD=

# Optional backend geocoding
GOOGLE_MAPS_API_KEY=

# Google federated sign-in. Required for the "Continue with Google" button —
# use the OAuth 2.0 Web client ID from the Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=

# Transactional email (account verification, workspace invitations) via Resend.
RESEND_API_KEY=
MAIL_FROM=Acureal <no-reply@acureal.in>
# Absolute base URL used to build verification / invitation links.
# Origin used to build verification / password-reset links in outbound email.
# MUST be the real public origin on any deploy (e.g. https://acureal.in). If it
# is unset on a deploy the send path throws rather than emailing a localhost
# link that looks fine and is dead on arrival.
APP_BASE_URL=http://localhost:5173

# ─── Inbound email ingestion (Tier-0 data flywheel) ─────────────────────────
# Webhook auth: choose one (HMAC preferred, Basic for Postmark free tier).
# HMAC: provider signs raw body as `X-Webhook-Signature: sha256=<hex>` keyed
#       by this shared secret. Mismatched signatures are 401 (no fallthrough).
INGEST_WEBHOOK_HMAC_KEY=
# Basic: only used when HMAC is not configured. Postmark URL becomes
#       `https://<user>:<pass>@api.redip.app/api/ingest/email/postmark`.
INGEST_WEBHOOK_BASIC_USER=
INGEST_WEBHOOK_BASIC_PASS=
# Org routing: MVP single-tenant. Every inbound email lands in this org.
# Multi-tenant routing via MailboxHash is a TODO once a 2nd org onboards.
DEFAULT_INGEST_ORGANIZATION_ID=
