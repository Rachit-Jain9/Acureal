VITE_API_URL=/api

# Google Maps JS API key (browser-exposed).
# Used by the Comps page split-view map. Must be a key with
# HTTP referrer restrictions enabled in Google Cloud Console:
#   https://redip.vercel.app/*
#   https://*.vercel.app/*  (preview deploys)
#   http://localhost:5173/*  (local dev)
# This is DIFFERENT from the backend GOOGLE_MAPS_API_KEY, which is used for
# Geocoding API server-side calls. You can either reuse the same key (if it
# allows both APIs and has the right referrer restrictions) or provision a
# separate key dedicated to Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
