{
  "version": 2,
  "framework": null,
  "buildCommand": "cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install --prefix backend && npm install --include=dev --prefix frontend && npm install --prefix packages/financial-kernel --include=dev && (cd packages/financial-kernel && npx tsc -p tsconfig.build.json)",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{backend,packages/financial-kernel/dist}/**"
    },
    "api/investor-package.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "packages/financial-kernel/src/debt-engine-py/**"
    }
  },
  "crons": [
    {
      "path": "/api/fx/refresh/daily",
      "schedule": "5 3 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/investor-package(/.*)?", "destination": "/api/investor-package" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
